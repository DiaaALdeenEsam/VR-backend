# Copy to .env and adjust as needed.

# SQLAlchemy async URL. Default is a local SQLite file next to this project.
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Log SQL statements (verbose; useful for debugging).
DB_ECHO=false

# JSON array of allowed CORS origins.
CORS_ORIGINS=["*"]

# Which PatientReplyGenerator backs POST /sessions/{id}/messages:
#   qwen  -- local Qwen2.5-0.5B-Instruct model (app/infrastructure/qwen_patient_generator.py).
#            Downloads ~1GB of weights to the HF cache on first use; falls back to a placeholder
#            reply automatically if the model/deps aren't available. Runs on CPU by default.
#   stub  -- fixed echo reply, no ML dependency at all (fast, deterministic; what the test suite
#            uses by default -- see tests/conftest.py).
PATIENT_REPLY_BACKEND=qwen

# Which EvaluationGenerator backs POST /sessions/{id}/evaluate:
#   stub  -- the only backend today (app/infrastructure/stub_evaluator.py); deterministic,
#            realistic-shaped placeholder grading, no ML dependency. A real/local LLM-backed
#            evaluator can be added later as a new option here.
EVALUATION_BACKEND=stub

# Which SpeechToTextPort backs POST /transcribe, POST /sessions/{id}/chat-voice, and WS /ws/voice:
#   colab   -- HTTP call to the self-hosted Whisper model exposed by the Colab notebook at
#              colab/leva_stt_tts_notebook.py (app/infrastructure/colab_stt_adapter.py). Needs
#              COLAB_API_BASE_URL set below.
#   whisper -- DEPRECATED, kept only for rollback. Local faster-whisper "tiny" model, forced
#              Arabic, CPU-only (app/infrastructure/legacy/local_whisper_stt_adapter.py).
#              Downloads ~75MB of weights on first use; falls back to the stub adapter
#              automatically if unavailable.
#   stub    -- fixed placeholder transcript, no ML dependency (what the test suite uses by
#              default -- see tests/conftest.py).
STT_BACKEND=colab

# Which TextToSpeechPort backs the same three voice endpoints:
#   colab -- HTTP call to the self-hosted leva-tts model exposed by the Colab notebook at
#            colab/leva_stt_tts_notebook.py (app/infrastructure/colab_tts_adapter.py). Needs
#            COLAB_API_BASE_URL set below.
#   gtts  -- DEPRECATED, kept only for rollback. gTTS (app/infrastructure/legacy/local_tts_adapter.py).
#            Note this makes a network call to Google Translate's TTS endpoint per request --
#            not offline. Falls back to the stub adapter's silent placeholder WAV automatically
#            if unavailable.
#   stub  -- silent placeholder WAV, no network/ML dependency (what the test suite uses by
#            default).
TTS_BACKEND=colab

# Base URL of the Colab-hosted STT/TTS API (see colab/leva_stt_tts_notebook.py), used when
# STT_BACKEND and/or TTS_BACKEND above is "colab". This is the ngrok URL printed at the bottom
# of the Colab notebook's last cell -- it changes every time the notebook is restarted (a free
# ngrok tunnel gets a new random URL each run), so just update this line, no code changes needed.
# No trailing slash. Example: COLAB_API_BASE_URL=https://xxxx-xx-xx-xxx-xx.ngrok-free.app
COLAB_API_BASE_URL=https://synopsis-affidavit-debate.ngrok-free.dev

# Per-request timeout (seconds) for calls to the Colab API above. Generous by default since this
# is a real network hop through ngrok to a Colab GPU runtime, which can be slow or drop entirely.
COLAB_API_TIMEOUT_SECONDS=30

# Base URL of the external RAG (retrieval-only) API (app/infrastructure/rag_client_adapter.py).
# No trailing slash. Example: RAG_API_BASE_URL=https://vr-rag-api.nport.link
RAG_API_BASE_URL=

# API key for the RAG API, sent as the X-API-Key header. Fill this in yourself -- never commit a
# real value here or anywhere else in this repo.
RAG_API_KEY=

# Connect/read timeouts (seconds) for calls to the RAG API above.
RAG_API_TIMEOUT_CONNECT_SECONDS=5
RAG_API_TIMEOUT_READ_SECONDS=60

# Retry policy for the RAG API: retry transient 503s with backoff, never retry
# 401/422 (see app/infrastructure/rag_client_adapter.py). Total attempts includes
# the first try, e.g. 3 = 1 initial attempt + up to 2 retries.
RAG_API_MAX_ATTEMPTS=3
RAG_API_RETRY_BACKOFF_SECONDS=1
